<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================================================= -->
  <!-- VEHICLE PARAMETERS                                        -->
  <!-- ========================================================= -->

  <!-- Chassis -->
  <xacro:property name="chassis_length" value="1.20"/>
  <xacro:property name="chassis_width"  value="0.60"/>
  <xacro:property name="chassis_height" value="0.12"/>

  <!-- Wheels -->
  <!-- Diameter = 20 cm -->
  <xacro:property name="wheel_radius" value="0.10"/>
  <xacro:property name="wheel_width"  value="0.07"/>

  <!-- Front / rear axle positions -->
  <xacro:property name="front_axle_x" value="0.38"/>
  <xacro:property name="rear_axle_x"  value="-0.38"/>

  <!-- Track = 60 cm -->
  <xacro:property name="half_track" value="0.30"/>

  <!-- Steering -->
  <!-- 35 degrees -->
  <xacro:property
      name="max_steering"
      value="0.610865"/>


  <!-- ========================================================= -->
  <!-- BASE FOOTPRINT                                            -->
  <!-- ========================================================= -->

  <link name="base_footprint"/>


  <!-- ========================================================= -->
  <!-- MAIN CHASSIS                                              -->
  <!-- ========================================================= -->

  <link name="base_link">

    <visual>

      <origin
          xyz="0 0 0.22"
          rpy="0 0 0"/>

      <geometry>

        <box
            size="${chassis_length}
                   ${chassis_width}
                   ${chassis_height}"/>

      </geometry>

      <material name="body_blue">
        <color rgba="0.05 0.20 0.80 1.0"/>
      </material>

    </visual>


    <collision>

      <origin
          xyz="0 0 0.22"
          rpy="0 0 0"/>

      <geometry>

        <box
            size="${chassis_length}
                   ${chassis_width}
                   ${chassis_height}"/>

      </geometry>

    </collision>


    <xacro:box_inertia
        mass="12.0"
        x="${chassis_length}"
        y="${chassis_width}"
        z="${chassis_height}"/>

  </link>


  <!-- ========================================================= -->
  <!-- BASE FOOTPRINT JOINT                                      -->
  <!-- ========================================================= -->

  <joint
      name="base_footprint_joint"
      type="fixed">

    <parent link="base_footprint"/>
    <child link="base_link"/>

    <origin
        xyz="0 0 0"
        rpy="0 0 0"/>

  </joint>


  <!-- ========================================================= -->
  <!-- FRONT STEERING KNUCKLE MACRO                             -->
  <!-- ========================================================= -->

  <xacro:macro
      name="front_wheel"
      params="side y">

    <!-- ======================================================= -->
    <!-- STEERING KNUCKLE                                        -->
    <!-- ======================================================= -->

    <link name="front_${side}_steering_link">

      <visual>

        <geometry>

          <box
              size="0.10 0.07 0.16"/>

        </geometry>

        <material name="metal">
          <color rgba="0.45 0.45 0.45 1.0"/>
        </material>

      </visual>


      <collision>

        <geometry>

          <box
              size="0.10 0.07 0.16"/>

        </geometry>

      </collision>


      <xacro:box_inertia
          mass="0.30"
          x="0.10"
          y="0.07"
          z="0.16"/>

    </link>


    <!-- ======================================================= -->
    <!-- STEERING JOINT                                          -->
    <!-- ======================================================= -->

    <joint
        name="front_${side}_steering_joint"
        type="revolute">

      <parent link="base_link"/>

      <child link="front_${side}_steering_link"/>

      <origin
          xyz="${front_axle_x}
                ${y}
                ${wheel_radius}"
          rpy="0 0 0"/>

      <axis xyz="0 0 1"/>

      <limit
          lower="${-max_steering}"
          upper="${max_steering}"
          effort="50"
          velocity="2.0"/>

      <dynamics
          damping="1.0"
          friction="0.2"/>

    </joint>


    <!-- ======================================================= -->
    <!-- FRONT WHEEL                                             -->
    <!-- ======================================================= -->

    <link name="front_${side}_wheel">

      <visual>

        <!-- Cylinder axis becomes Y -->
        <origin
            xyz="0 0 0"
            rpy="${pi/2} 0 0"/>

        <geometry>

          <cylinder
              radius="${wheel_radius}"
              length="${wheel_width}"/>

        </geometry>

        <material name="rubber">
          <color rgba="0.02 0.02 0.02 1.0"/>
        </material>

      </visual>


      <collision>

        <origin
            xyz="0 0 0"
            rpy="${pi/2} 0 0"/>

        <geometry>

          <cylinder
              radius="${wheel_radius}"
              length="${wheel_width}"/>

        </geometry>

      </collision>


      <xacro:cylinder_inertia
          mass="0.75"
          radius="${wheel_radius}"
          length="${wheel_width}"/>

    </link>


    <!-- ======================================================= -->
    <!-- FRONT WHEEL ROTATION                                    -->
    <!-- ======================================================= -->

    <joint
        name="front_${side}_wheel_joint"
        type="continuous">

      <parent link="front_${side}_steering_link"/>

      <child link="front_${side}_wheel"/>

      <origin
          xyz="0 0 0"
          rpy="0 0 0"/>

      <axis xyz="0 1 0"/>

      <dynamics
          damping="0.05"
          friction="0.01"/>

    </joint>

  </xacro:macro>


  <!-- ========================================================= -->
  <!-- FRONT LEFT                                               -->
  <!-- ========================================================= -->

  <xacro:front_wheel
      side="left"
      y="${half_track}"/>


  <!-- ========================================================= -->
  <!-- FRONT RIGHT                                              -->
  <!-- ========================================================= -->

  <xacro:front_wheel
      side="right"
      y="${-half_track}"/>


  <!-- ========================================================= -->
  <!-- REAR WHEEL MACRO                                         -->
  <!-- ========================================================= -->

  <xacro:macro
      name="rear_wheel"
      params="side y">

    <link name="rear_${side}_wheel">

      <visual>

        <origin
            xyz="0 0 0"
            rpy="${pi/2} 0 0"/>

        <geometry>

          <cylinder
              radius="${wheel_radius}"
              length="${wheel_width}"/>

        </geometry>

        <material name="rubber">
          <color rgba="0.02 0.02 0.02 1.0"/>
        </material>

      </visual>


      <collision>

        <origin
            xyz="0 0 0"
            rpy="${pi/2} 0 0"/>

        <geometry>

          <cylinder
              radius="${wheel_radius}"
              length="${wheel_width}"/>

        </geometry>

      </collision>


      <xacro:cylinder_inertia
          mass="0.75"
          radius="${wheel_radius}"
          length="${wheel_width}"/>

    </link>


    <!-- ======================================================= -->
    <!-- REAR WHEEL JOINT                                        -->
    <!-- ======================================================= -->

    <joint
        name="rear_${side}_wheel_joint"
        type="continuous">

      <parent link="base_link"/>

      <child link="rear_${side}_wheel"/>

      <origin
          xyz="${rear_axle_x}
                ${y}
                ${wheel_radius}"
          rpy="0 0 0"/>

      <axis xyz="0 1 0"/>

      <dynamics
          damping="0.05"
          friction="0.01"/>

    </joint>

  </xacro:macro>


  <!-- ========================================================= -->
  <!-- REAR LEFT                                                -->
  <!-- ========================================================= -->

  <xacro:rear_wheel
      side="left"
      y="${half_track}"/>


  <!-- ========================================================= -->
  <!-- REAR RIGHT                                               -->
  <!-- ========================================================= -->

  <xacro:rear_wheel
      side="right"
      y="${-half_track}"/>


  <!-- ========================================================= -->
  <!-- REAR AXLE                                                 -->
  <!-- ========================================================= -->

  <link name="rear_axle_link">

    <visual>

      <origin
          xyz="0 0 0"
          rpy="${pi/2} 0 0"/>

      <geometry>

        <cylinder
            radius="0.018"
            length="${2 * half_track}"/>

      </geometry>

      <material name="metal">
        <color rgba="0.4 0.4 0.4 1.0"/>
      </material>

    </visual>

  </link>


  <joint
      name="rear_axle_joint"
      type="fixed">

    <parent link="base_link"/>

    <child link="rear_axle_link"/>

    <origin
        xyz="${rear_axle_x} 0 ${wheel_radius}"
        rpy="0 0 0"/>

  </joint>


  <!-- ========================================================= -->
  <!-- SINGLE REAR MOTOR                                        -->
  <!-- ========================================================= -->

  <link name="rear_motor_link">

    <visual>

      <geometry>

        <cylinder
            radius="0.055"
            length="0.12"/>

      </geometry>

      <material name="motor_gray">
        <color rgba="0.20 0.20 0.20 1.0"/>
      </material>

    </visual>


    <xacro:cylinder_inertia
        mass="1.0"
        radius="0.055"
        length="0.12"/>

  </link>


  <joint
      name="rear_motor_mount_joint"
      type="fixed">

    <parent link="base_link"/>

    <child link="rear_motor_link"/>

    <origin
        xyz="${rear_axle_x} 0 0.13"
        rpy="0 ${pi/2} 0"/>

  </joint>


  <!-- ========================================================= -->
  <!-- FRONT STEERING SERVO                                     -->
  <!-- ========================================================= -->

  <link name="steering_servo_link">

    <visual>

      <geometry>

        <box
            size="0.12 0.06 0.08"/>

      </geometry>

      <material name="servo_black">
        <color rgba="0.08 0.08 0.08 1.0"/>
      </material>

    </visual>


    <xacro:box_inertia
        mass="0.30"
        x="0.12"
        y="0.06"
        z="0.08"/>

  </link>


  <!-- Servo located toward front center -->
  <joint
      name="steering_servo_mount_joint"
      type="fixed">

    <parent link="base_link"/>

    <child link="steering_servo_link"/>

    <origin
        xyz="0.22 0 0.32"
        rpy="0 0 0"/>

  </joint>


  <!-- ========================================================= -->
  <!-- STEERING LINKAGE                                         -->
  <!-- ========================================================= -->

  <link name="steering_linkage">

    <visual>

      <geometry>

        <box
            size="0.50 0.025 0.025"/>

      </geometry>

      <material name="metal">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>

    </visual>

  </link>


  <joint
      name="steering_linkage_joint"
      type="fixed">

    <parent link="base_link"/>

    <child link="steering_linkage"/>

    <origin
        xyz="${front_axle_x} 0 ${wheel_radius}"
        rpy="0 0 0"/>

  </joint>


  <!-- ========================================================= -->
  <!-- GAZEBO WHEEL FRICTION                                    -->
  <!-- ========================================================= -->

  <gazebo reference="front_left_wheel">

    <mu1>1.5</mu1>
    <mu2>1.5</mu2>

    <kp>1000000.0</kp>
    <kd>10.0</kd>

  </gazebo>


  <gazebo reference="front_right_wheel">

    <mu1>1.5</mu1>
    <mu2>1.5</mu2>

    <kp>1000000.0</kp>
    <kd>10.0</kd>

  </gazebo>


  <gazebo reference="rear_left_wheel">

    <mu1>1.5</mu1>
    <mu2>1.5</mu2>

    <kp>1000000.0</kp>
    <kd>10.0</kd>

  </gazebo>


  <gazebo reference="rear_right_wheel">

    <mu1>1.5</mu1>
    <mu2>1.5</mu2>

    <kp>1000000.0</kp>
    <kd>10.0</kd>

  </gazebo>


</robot>